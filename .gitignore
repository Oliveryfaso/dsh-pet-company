# Only reviewed project deliverables may be tracked. Local references stay local.
/*
!/.gitignore
!/.github/
!/package.json
!/client.js
!/cordis.patch.yml
!/screenshots.json
!/README.md
!/CHANGELOG.md
!/LICENSE
!/CODE-LICENSE.md
!/ASSET-LICENSE.md
!/THIRD_PARTY_NOTICES.md
!/src/
!/test/
!/scripts/
!/pet/
!/assets/
/assets/*
!/assets/characters/
!/assets/upstream/
!/docs/
/docs/*
!/docs/INSTALL.md
!/docs/COMPATIBILITY.md
!/docs/MARKET.md
!/docs/ARCHITECTURE.md
!/docs/screenshots/
# Never track machine data, dependencies, or platform resource forks.
**/node_modules/
**/._*
**/.DS_Store
**/.env*
**/*credentials*
**/*.log
**/*.db
**/*.sqlite*
**/*.pem
**/*.key
**/*.tgz
**/__pycache__/

# Reviewed, independent feedback source/demo and sanitized evidence.
!/compat/
!/tests/
!/docs/qa/
/docs/qa/*
!/docs/qa/feedback/

!/docs/qa/visual-stability/

!/vendor/
!/runtime/
